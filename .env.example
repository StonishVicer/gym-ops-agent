# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
MODEL_ID=anthropic/claude-haiku-4.5
DB_PATH=data/gym.db

# Deterministic seed (make seed). Data is generated relative to REFERENCE_DATE,
# never the wall clock, so the same values always rebuild an identical DB.
SEED=42
SEED_MEMBERS=300
REFERENCE_DATE=2026-09-25
